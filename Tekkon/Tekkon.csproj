<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ReleaseVersion>1.7.1</ReleaseVersion>
    <PackageId>vChewing.Tekkon</PackageId>
    <Authors>Shiki Suen</Authors>
    <Company>Atelier Inmu</Company>
    <Copyright>(c) 2022 and onwards The vChewing Project (LGPL v3.0 License or later).</Copyright>
    <RepositoryUrl>https://github.com/ShikiSuen/TekkonNT</RepositoryUrl>
    <NeutralLanguage>zh-TW</NeutralLanguage>
    <AssemblyVersion>1.7.1</AssemblyVersion>
    <FileVersion>1.7.1</FileVersion>
    <Version>1.7.1</Version>
    <Product>Tekkon</Product>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <Description>Tekkon Engine is a module made for processing lingual data of an input method.</Description>
    <PackageProjectUrl>https://github.com/ShikiSuen/TekkonNT</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFrameworks>net46;net6.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <LangVersion>10.0</LangVersion>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <LangVersion>10.0</LangVersion>
    <DebugType>none</DebugType>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <!--
    讓 Tekkon.Tests 得以觸及 internal 成員（例如 StringExtensions.DoesHave 之邊界語意），
    否則該等內部工具只能間接驗證。此設定不改變公開 API、亦不改變執行期行為；
    其作用範圍僅限名為 Tekkon.Tests 之組件。
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Tekkon.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
